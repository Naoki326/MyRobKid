CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# **内存约束与窗口取舍（2026-09-12 实测推翻初版 ADR-0011 的两个判断）**
#
# 1) 接收缓冲是**真实分配**的内部 RAM，不是可自由调大的旋钮。初版提到 8/16/6
#    后，设备运行时 free sram 从 41067 掉到 **9919**、minimal 掉到 **2095**，
#    并出现 `Failed to create music start task`（OOM）。内部 SRAM 已被
#    camera/LVGL/AFE 吃得紧，原值 3/6/3 是为省内存选的，不是错配。
#
# 2) lwIP TCP 窗口**不是瓶颈**，没必要为它花内存。带宽时延积（BDP）
#    分析：局域网 RTT 3.5–30ms 下，5760B 窗口的理论上限是 188–1607KB/s，
#    而验收目标是 200KB/s——**窗口从未限制过吞吐**。把它提到 16384 是每
#    socket +10.4KB × 两个方向，纯浪费。
#
# 结论：**只保留 IRAM 加速**（它是段内挪移，不占运行时堆，且是吞吐主来源）。
# 缓冲与窗口维持原值。真正的吞吐出路是让 WiFi/lwIP 缓冲走 PSRAM
# （CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP），需单独验证延迟后再上，见 ADR-0011。
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
# 显式写成 IDF 默认值（= 4×MSS），不是靠缺省——避免下次有人看到「没写」
# 就以为可以随便调。BDP 分析表明局域网下窗口不是瓶颈，无需上调。
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
