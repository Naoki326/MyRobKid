+
+
+#define BUILTIN_LED_GPIO        GPIO_NUM_48
+#define STATE_OUTPUT_GPIO       GPIO_NUM_47
+#define BOOT_BUTTON_GPIO        GPIO_NUM_11
+#define TOUCH_BUTTON_GPIO       GPIO_NUM_NC
+#define VOLUME_UP_BUTTON_GPIO   GPIO_NUM_NC
+#define VOLUME_DOWN_BUTTON_GPIO GPIO_NUM_NC
+
+#define BATTERY_ADC_CHANNEL      ADC_CHANNEL_2  // GPIO3
+#define BATTERY_REF_ADC_CHANNEL  ADC_CHANNEL_3  // GPIO4
+#define VOLUME_KEY_ADC_CHANNEL   ADC_CHANNEL_8  // GPIO9
+#define VOLUME_DOWN_KEY_MIN_MV   0
+#define VOLUME_DOWN_KEY_MAX_MV   700
+#define VOLUME_UP_KEY_MIN_MV     900
+#define VOLUME_UP_KEY_MAX_MV     3000
+#define BATTERY_REF_VOLTAGE_MV   1270
+#define CHARGER_DETECT_RATIO     1.3f
+#define BATTERY_FULL_VOLTAGE_MV  4200
+
+//Camera Config
+#define CAMERA_PIN_D0      GPIO_NUM_7
+#define CAMERA_PIN_D1      GPIO_NUM_43
+#define CAMERA_PIN_D2      GPIO_NUM_5
+#define CAMERA_PIN_D3      GPIO_NUM_6
+#define CAMERA_PIN_D4      GPIO_NUM_8
+#define CAMERA_PIN_D5      GPIO_NUM_44
+#define CAMERA_PIN_D6      GPIO_NUM_10
+#define CAMERA_PIN_D7      GPIO_NUM_15
+#define CAMERA_PIN_XCLK    GPIO_NUM_17
+#define CAMERA_PIN_PCLK    GPIO_NUM_16
+#define CAMERA_PIN_VSYNC   GPIO_NUM_21
+#define CAMERA_PIN_HREF    GPIO_NUM_18
+#define CAMERA_PIN_SIOD    GPIO_NUM_1     // SDA = I2C Data (共用音频 I2C 总线)
+#define CAMERA_PIN_SIOC    GPIO_NUM_2     // SCL = I2C Clock (共用音频 I2C 总线)
+#define CAMERA_PIN_PWDN    GPIO_NUM_NC
+#define CAMERA_PIN_RESET   GPIO_NUM_NC
+#define XCLK_FREQ_HZ       24000000
+
+
+#define DISPLAY_BACKLIGHT_PIN GPIO_NUM_42
+#define DISPLAY_MOSI_PIN      GPIO_NUM_41
+#define DISPLAY_CLK_PIN       GPIO_NUM_46
+#define DISPLAY_DC_PIN        GPIO_NUM_39
+#define DISPLAY_RST_PIN       GPIO_NUM_NC
+#define DISPLAY_CS_PIN        GPIO_NUM_40
+
+
+// LCD ST7789 Config
+#define LCD_TYPE_ST7789_SERIAL
+#define DISPLAY_WIDTH   240
