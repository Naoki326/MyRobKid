+namespace {
+constexpr int kHttpTimeoutMs = 5000;
+constexpr size_t kHttpReadBufferSize = 4096;
+// Input ring for the MP3 decoder: holds one HTTP chunk plus leftovers.
+constexpr size_t kMp3InputBufferSize = 16 * 1024;
+constexpr uint32_t kPushPcmTimeoutMs = 1000;
+// Upper bound for Stop(): must exceed the HTTP read timeout.
+constexpr uint32_t kStopWaitTimeoutMs = 6000;
+constexpr uint32_t kMusicTaskStackSize = 10240;
+constexpr UBaseType_t kMusicTaskPriority = 2;
+const char* TAG = "MusicPlayer";
+
+#define MUSIC_RATE_CVT_CFG(_src_rate, _dest_rate)           \
+    (esp_ae_rate_cvt_cfg_t)                                 \
+    {                                                       \
+        .src_rate        = (uint32_t)(_src_rate),           \
+        .dest_rate       = (uint32_t)(_dest_rate),          \
+        .channel         = 1,                               \
+        .bits_per_sample = ESP_AUDIO_BIT16,                 \
+        .complexity      = 2,                               \
+        .perf_type       = ESP_AE_RATE_CVT_PERF_TYPE_SPEED, \
+    }
+
+bool IsSupportedUrl(const std::string& url) {
+    return url.compare(0, 7, "http://") == 0 || url.compare(0, 8, "https://") == 0;
+}
+
+bool EndsWithIgnoreCase(const std::string& text, const std::string& suffix) {
+    if (text.size() < suffix.size()) {
+        return false;
+    }
+    return strncasecmp(text.c_str() + text.size() - suffix.size(), suffix.c_str(), suffix.size()) == 0;
+}
+
+}  // namespace
+
+MusicPlayer::MusicPlayer(AudioService& audio_service) : audio_service_(audio_service) {}
+
+MusicPlayer::~MusicPlayer() {
+    Stop();
+}
+
+bool MusicPlayer::Play(std::string url) {
+    if (!IsSupportedUrl(url)) {
+        ESP_LOGE(TAG, "Unsupported URL: %s", url.c_str());
+        return false;
+    }
+
+    Stop();
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        url_ = url;
+        worker_running_ = true;
+    }
+    playing_.store(true);
+    stop_requested_.store(false);
+
+    BaseType_t created = xTaskCreate(WorkerEntry, "music_http", kMusicTaskStackSize, this,
+                                     kMusicTaskPriority, &task_handle_);
+    if (created != pdPASS) {
+        ESP_LOGE(TAG, "Failed to create music worker task");
+        playing_.store(false);
+        std::lock_guard<std::mutex> lock(mutex_);
+        worker_running_ = false;
+        task_handle_ = nullptr;
+        return false;
+    }
+    return true;
+}
+
+void MusicPlayer::Stop() {
+    stop_requested_.store(true);
+    playing_.store(false);
+    {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (!worker_running_) {
+            return;
+        }
+        // The worker checks stop_requested_ after every HTTP read and decode
+        // step. The wait bound only matters when it is stuck inside a read.
+        stop_cv_.wait_for(lock, std::chrono::milliseconds(kStopWaitTimeoutMs),
+                          [this]() { return !worker_running_; });
+    }
+}
+
+void MusicPlayer::WorkerEntry(void* arg) {
+    auto* player = static_cast<MusicPlayer*>(arg);
+    std::string url;
+    {
+        std::lock_guard<std::mutex> lock(player->mutex_);
+        url = player->url_;
+    }
+    player->WorkerTask(std::string(url));
+    vTaskDelete(nullptr);
+}
+
+void MusicPlayer::WorkerTask(std::string url) {
+    bool success = false;
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+    if (http) {
+        http->SetTimeout(kHttpTimeoutMs);
+        http->SetHeader("Accept", "audio/mpeg, audio/ogg, application/ogg");
+        http->SetHeader("Accept-Encoding", "identity");
+        http->SetHeader("User-Agent", "XiaoZhi-MusicPlayer/1.0");
+        const bool opened = http->Open("GET", url);
+        if (opened) {
+            const int status = http->GetStatusCode();
+            if (status >= 200 && status < 300 && !stop_requested_.load()) {
+                // Drop anything still queued from the previous session (e.g.
+                // lingering TTS) so the music starts from a clean pipeline.
+                audio_service_.ResetDecoder();
+
+                std::string content_type = http->GetResponseHeader("Content-Type");
+                std::transform(content_type.begin(), content_type.end(), content_type.begin(),
+                               [](unsigned char c) { return static_cast<char>(::tolower(c)); });
+
+                const bool is_mp3 = content_type.find("audio/mpeg") != std::string::npos ||
+                                    content_type.find("audio/mp3") != std::string::npos ||
+                                    EndsWithIgnoreCase(url, ".mp3");
+                success = is_mp3 ? StreamMp3(http.get()) : StreamOgg(http.get());
+            } else {
+                ESP_LOGE(TAG, "Music HTTP request returned status %d", status);
+            }
+        } else {
+            ESP_LOGE(TAG, "Failed to open music HTTP request: %d", http->GetLastError());
+        }
+        http->Close();
+        http.reset();
+    } else {
+        ESP_LOGE(TAG, "Failed to create HTTP client");
+    }
+
+    ESP_LOGI(TAG, "Music worker finished (%s): %s", success ? "completed" : "interrupted",
+             url.c_str());
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        worker_running_ = false;
+        task_handle_ = nullptr;
+    }
+    playing_.store(false);
+    stop_cv_.notify_all();
+}
+
+bool MusicPlayer::StreamOgg(Http* http) {
+    // OGG/Opus streams reuse the notification pipeline: demux to Opus
+    // packets and push them into the decode queue with backpressure.
+    auto demuxer = std::make_unique<OggDemuxer>();
+    bool packet_error = false;
+    demuxer->OnPacket([this, &packet_error](const uint8_t* data, int sample_rate,
+                                            int frame_duration_ms, size_t size) {
+        if (packet_error || stop_requested_.load()) {
+            packet_error = true;
+            return;
+        }
+        auto packet = std::make_unique<AudioStreamPacket>();
+        packet->sample_rate = sample_rate;
+        packet->frame_duration = frame_duration_ms;
+        packet->payload.assign(data, data + size);
+        if (!audio_service_.PushPacketToDecodeQueue(std::move(packet), true)) {
+            packet_error = true;
+        }
+    });
+    demuxer->Reset();
+
+    std::vector<uint8_t> buffer(kHttpReadBufferSize);
+    while (!packet_error && !stop_requested_.load()) {
+        int size = http->Read(reinterpret_cast<char*>(buffer.data()), buffer.size());
+        if (size < 0) {
+            ESP_LOGE(TAG, "Music HTTP read failed: %d", http->GetLastError());
+            return false;
+        }
+        if (size == 0) {
+            bool complete = demuxer->Finish();
+            if (!complete) {
+                ESP_LOGW(TAG, "Music Ogg stream ended mid-frame");
+            }
+            return complete;
+        }
+        demuxer->Process(buffer.data(), size);
+        if (demuxer->HasError()) {
+            packet_error = true;
+        }
+    }
+    return false;
+}
+
+bool MusicPlayer::StreamMp3(Http* http) {
+    esp_audio_dec_handle_t decoder = nullptr;
+    esp_audio_dec_cfg_t dec_cfg = {
+        .type = ESP_AUDIO_TYPE_MP3,
+        .cfg = nullptr,
+        .cfg_sz = 0,
+    };
+    esp_audio_err_t ret = esp_audio_dec_open(&dec_cfg, &decoder);
+    if (ret != ESP_AUDIO_ERR_OK) {
+        ESP_LOGE(TAG, "Failed to open MP3 decoder: %d", ret);
+        return false;
+    }
+
+    // Decoder input (PSRAM) and output buffers. The output grows on demand
+    // when the decoder reports ESP_AUDIO_ERR_BUFF_NOT_ENOUGH.
+    uint8_t* input = static_cast<uint8_t*>(heap_caps_calloc(1, kMp3InputBufferSize, MALLOC_CAP_SPIRAM));
+    std::vector<uint8_t> output(8192);
+    bool success = false;
+    if (input == nullptr) {
+        ESP_LOGE(TAG, "Failed to allocate MP3 input buffer");
+        esp_audio_dec_close(decoder);
+        return false;
+    }
+
+    esp_ae_rate_cvt_handle_t resampler = nullptr;
+    int resampler_src_rate = 0;
+    const int codec_rate = Board::GetInstance().GetAudioCodec()->output_sample_rate();
+    size_t have = 0;
+
+    while (!stop_requested_.load()) {
+        if (have < kMp3InputBufferSize) {
+            int size = http->Read(reinterpret_cast<char*>(input + have), kMp3InputBufferSize - have);
+            if (size < 0) {
+                ESP_LOGE(TAG, "Music HTTP read failed: %d", http->GetLastError());
+                break;
+            }
+            if (size == 0) {
+                success = true;  // Stream finished cleanly.
+                break;
+            }
+            have += size;
+        }
+
+        esp_audio_dec_in_raw_t raw = {
+            .buffer = input,
+            .len = static_cast<uint32_t>(have),
+            .consumed = 0,
+            .frame_recover = ESP_AUDIO_DEC_RECOVERY_NONE,
+        };
+        bool decode_error = false;
+        while (raw.len > 0 && !stop_requested_.load()) {
+            esp_audio_dec_out_frame_t out_frame = {
+                .buffer = output.data(),
+                .len = static_cast<uint32_t>(output.size()),
+                .needed_size = 0,
+                .decoded_size = 0,
+            };
+            ret = esp_audio_dec_process(decoder, &raw, &out_frame);
+            if (ret == ESP_AUDIO_ERR_BUFF_NOT_ENOUGH) {
+                output.resize(out_frame.needed_size);
+                continue;  // Retry with the grown buffer, do not advance raw.
+            }
+            if (ret != ESP_AUDIO_ERR_OK || out_frame.decoded_size == 0) {
+                // Skip a malformed frame instead of aborting the stream.
+                const uint32_t consumed = raw.consumed > 0 ? raw.consumed : 1;
+                raw.buffer += consumed;
+                raw.len -= std::min(consumed, raw.len);
+                decode_error = true;
+                continue;
+            }
+
+            esp_audio_dec_info_t info = {};
+            esp_audio_dec_get_info(decoder, &info);
+
+            // Downmix to mono (int16 interleaved).
+            const int channels = std::max(1, static_cast<int>(info.channel));
+            const size_t samples_per_channel = out_frame.decoded_size / (sizeof(int16_t) * channels);
+            std::vector<int16_t> mono(samples_per_channel);
+            const auto* frame = reinterpret_cast<const int16_t*>(out_frame.buffer);
+            if (channels == 1) {
+                std::memcpy(mono.data(), frame, samples_per_channel * sizeof(int16_t));
+            } else {
+                for (size_t i = 0; i < samples_per_channel; ++i) {
+                    int32_t acc = 0;
+                    for (int ch = 0; ch < channels; ++ch) {
+                        acc += frame[i * channels + ch];
+                    }
+                    mono[i] = static_cast<int16_t>(acc / channels);
+                }
+            }
+
+            // (Re)open the resampler when the source rate changes.
+            if (resampler == nullptr || resampler_src_rate != static_cast<int>(info.sample_rate)) {
+                if (resampler != nullptr) {
+                    esp_ae_rate_cvt_close(resampler);
+                    resampler = nullptr;
+                }
+                if (static_cast<int>(info.sample_rate) != codec_rate) {
+                    esp_ae_rate_cvt_cfg_t cfg = MUSIC_RATE_CVT_CFG(info.sample_rate, codec_rate);
+                    if (esp_ae_rate_cvt_open(&cfg, &resampler) != ESP_AE_ERR_OK) {
+                        ESP_LOGE(TAG, "Failed to open resampler %lu -> %d",
+                                 static_cast<unsigned long>(info.sample_rate), codec_rate);
+                        resampler = nullptr;
+                    }
+                    resampler_src_rate = static_cast<int>(info.sample_rate);
+                } else {
+                    resampler_src_rate = static_cast<int>(info.sample_rate);
+                }
+            }
+
+            std::vector<int16_t> out_pcm;
+            if (resampler != nullptr) {
+                uint32_t max_out = 0;
+                esp_ae_rate_cvt_get_max_out_sample_num(resampler, mono.size(), &max_out);
+                out_pcm.resize(max_out);
+                uint32_t actual = max_out;
+                if (esp_ae_rate_cvt_process(resampler,
+                                            reinterpret_cast<esp_ae_sample_t*>(mono.data()),
+                                            mono.size(),
+                                            reinterpret_cast<esp_ae_sample_t*>(out_pcm.data()),
+                                            &actual) != ESP_AE_ERR_OK ||
+                    actual == 0) {
+                    raw.buffer += raw.consumed;
+                    raw.len -= std::min(raw.consumed, raw.len);
+                    continue;
+                }
+                out_pcm.resize(actual);
+            } else {
+                out_pcm = std::move(mono);
+            }
+
+            if (!audio_service_.PushPcmToPlaybackQueue(std::move(out_pcm), kPushPcmTimeoutMs)) {
+                ESP_LOGW(TAG, "Playback queue push timed out or service stopped");
+                stop_requested_.store(true);
+                break;
+            }
+
+            raw.buffer += raw.consumed;
+            raw.len -= std::min(raw.consumed, raw.len);
+        }
+        (void)decode_error;
+
+        // Compact unconsumed input to the front of the buffer.
+        have = raw.len;
+        if (have > 0 && raw.buffer != input) {
+            std::memmove(input, raw.buffer, have);
+        }
+        // Guard against an undecodable stream filling the buffer forever.
+        if (have == kMp3InputBufferSize && decode_error) {
+            ESP_LOGE(TAG, "MP3 stream cannot be decoded, aborting");
+            break;
+        }
+    }
+
+    if (resampler != nullptr) {
+        esp_ae_rate_cvt_close(resampler);
+    }
+    heap_caps_free(input);
+    esp_audio_dec_close(decoder);
+    return success;
+}
diff --git a/main/audio/music_player.h b/main/audio/music_player.h
new file mode 100644
index 0000000..9592d9a
--- /dev/null
+++ b/main/audio/music_player.h
@@ -0,0 +1,60 @@
+#ifndef MUSIC_PLAYER_H_
+#define MUSIC_PLAYER_H_
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+
+#include "audio_service.h"
+
+/*
+ * MusicPlayer streams background music from an HTTP(S) URL into the audio
+ * output pipeline, alongside (and independently of) the voice session.
+ *
+ * Supported formats:
+ *   - OGG/Opus streams (same format as server notifications): packets are
+ *     demuxed and pushed into the decode queue, reusing the Opus path.
+ *   - MP3 streams: decoded in software via esp_audio_codec, downmixed to
+ *     mono, resampled to the codec output rate, and pushed as raw PCM.
+ *
+ * Playback is mutually exclusive with speech by design: starting music
+ * resets the playback queues, and a wake word stops the music.
+ */
+class MusicPlayer {
+public:
+    explicit MusicPlayer(AudioService& audio_service);
+    ~MusicPlayer();
+
+    // Starts streaming `url`. Any previous stream is stopped first.
+    // Returns true when the worker task was started.
+    bool Play(std::string url);
+
+    // Stops the current stream and waits (bounded) for the worker to exit.
+    void Stop();
+
+    bool IsPlaying() const { return playing_.load(); }
+    const std::string& current_url() const { return url_; }
+
+private:
+    static void WorkerEntry(void* arg);
+    void WorkerTask(std::string url);
+
+    bool StreamOgg(class Http* http);
+    bool StreamMp3(class Http* http);
+
+    AudioService& audio_service_;
+
+    mutable std::mutex mutex_;
+    std::condition_variable stop_cv_;
+    std::atomic<bool> playing_{false};
+    std::atomic<bool> stop_requested_{false};
+    bool worker_running_ = false;
+    TaskHandle_t task_handle_ = nullptr;
+    std::string url_;
+};
+
+#endif  // MUSIC_PLAYER_H_
