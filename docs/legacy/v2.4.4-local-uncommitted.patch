+void Application::ResetTtsBuffer() {
+    std::lock_guard<std::mutex> lock(tts_buffer_mutex_);
+    tts_buffering_ = false;
+    if (!tts_buffer_.empty()) {
+        ESP_LOGI(TAG, "Discarding %u buffered TTS packets", (unsigned)tts_buffer_.size());
+    }
+    tts_buffer_.clear();
+    tts_buffer_bytes_ = 0;
