+bool AudioService::PushPcmToPlaybackQueue(std::vector<int16_t>&& pcm, uint32_t timeout_ms) {
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_);
+    if (audio_playback_queue_.size() >= MAX_PLAYBACK_TASKS_IN_QUEUE) {
+        if (!audio_queue_cv_.wait_for(lock, std::chrono::milliseconds(timeout_ms), [this]() {
+                return service_stopped_.load() ||
+                       audio_playback_queue_.size() < MAX_PLAYBACK_TASKS_IN_QUEUE;
+            })) {
+            return false;  // Timed out: the output path is stuck.
+        }
+    }
+    if (service_stopped_.load()) {
+        return false;
+    }
+    auto task = std::make_unique<AudioTask>();
+    task->type = kAudioTaskTypeDecodeToPlaybackQueue;
+    task->pcm = std::move(pcm);
+    playback_drained_notified_ = false;
+    audio_playback_queue_.push_back(std::move(task));
+    audio_queue_cv_.notify_all();
+    return true;
+}
+
+size_t AudioService::PushPacketsToDecodeQueue(std::deque<std::unique_ptr<AudioStreamPacket>>& packets) {
+    size_t pushed = 0;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!service_stopped_.load()) {
+            for (auto& packet : packets) {
+                if (packet == nullptr) {
+                    continue;
+                }
+                audio_decode_queue_.push_back(std::move(packet));
+                pushed++;
+            }
+            if (pushed > 0) {
+                playback_drained_notified_ = false;
+                audio_queue_cv_.notify_all();
+            }
+        }
+    }
+    packets.clear();
+    return pushed;
+}
